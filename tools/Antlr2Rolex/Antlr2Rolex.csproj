<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Converts the ANTLR lexer grammar (src/ClosedXML.ANTLR/FormulaLexer.g4) into the Rolex
    grammars (src/ClosedXML.Parser/Rolex/Lexer*.rl). The test project references it to check
    that the committed Rolex grammars are still generated from the ANTLR grammar.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
