@implements IAsyncDisposable
@inject IJSRuntime JS

@* The JS module writes the SVG into the host element. Blazor renders no children there, so it never touches the SVG. *@
<div class="overflow-x-auto">
    <div id="diagram" @ref="_host" class="@(Dimmed ? "pointer-events-none opacity-40" : null)"></div>
</div>
@if (_status is not null)
{
    <p class="text-sm text-slate-500 dark:text-slate-400" role="status">@_status</p>
}

@code {
    private const string ModulePath = "./Components/MermaidDiagram.razor.js";

    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MermaidDiagram>? _self;
    private string? _renderedDefinition;
    private string? _renderedSelection;
    private string? _status = "Loading the diagram...";

    /// <summary>
    /// The Mermaid text of the diagram. The diagram is drawn again only when the text changes.
    /// </summary>
    [Parameter, EditorRequired]
    public string Definition { get; set; } = string.Empty;

    [Parameter]
    public string? SelectedNodeId { get; set; }

    /// <summary>
    /// Show the diagram faded, and ignore clicks. The page does this while the formula has an error.
    /// </summary>
    [Parameter]
    public bool Dimmed { get; set; }

    /// <summary>
    /// Called with the id of the clicked node, or with null for a click outside the nodes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> OnNodeClick { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await _module.InvokeVoidAsync("attach", _host, _self);
        }

        if (_module is null)
            return;

        if (Definition != _renderedDefinition)
        {
            _renderedDefinition = Definition;
            _renderedSelection = null;
            var result = await _module.InvokeAsync<RenderResult?>("render", _host, Definition);

            // A newer render started while this one ran. That render sets the status and the selection.
            if (result is null || result.Stale)
                return;

            var status = result.Error is null ? null : $"The diagram could not be drawn: {result.Error}";
            if (status != _status)
            {
                _status = status;
                StateHasChanged();
            }
        }

        if (SelectedNodeId != _renderedSelection)
        {
            _renderedSelection = SelectedNodeId;
            await _module.InvokeVoidAsync("select", _host, SelectedNodeId);
        }
    }

    [JSInvokable]
    public Task NodeClicked(string? nodeId) => OnNodeClick.InvokeAsync(nodeId);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _self?.Dispose();
    }

    public sealed record RenderResult(bool Stale, string? Error);
}
